# Copy this file to `.env` and adjust the values.
# `docker compose` reads `.env` automatically for variable substitution.

# NextAuth (frontend)
# Generate a secret with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# MongoDB used by the frontend (NextAuth adapter) - compose service name resolves on the Docker network
MONGODB_URI=mongodb://mongo:27017/PostsDB

# Node.js backend
JWT_SECRET=change-me

# Google APIs (optional)
GOOGLE_PLACES_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
GITHUB_ID=
GITHUB_SECRET=

# Google Gemini API key for the AI chatbot lives in back/llm_backend/.env.local
# (passed to the `llm` service via env_file in docker-compose.yml)
